# Public Bicycle Rental Management System (PBRMS) Configuration
# Copy this template to .env and configure your MySQL database credentials.
# The .env file is excluded by .gitignore and should never be committed.

# Application Settings
FLASK_ENV=development
SECRET_KEY=pbrms-super-secret-key-change-in-production-2026
JWT_EXPIRY_HOURS=24
PORT=5000

# MySQL 8 Configuration
# Use a dedicated database user (e.g., 'pbrms_user') created in MySQL Workbench
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pbrms_user
DB_PASSWORD=your_secure_mysql_password_here
DB_NAME=pbrms_db

# Active Database Mode
# Set to 'false' to use MySQL; set to 'true' only if falling back to SQLite
USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH=pbrms_dev.sqlite
